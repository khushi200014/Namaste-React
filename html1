<script 
crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js">
</script>





<!--heading inside react, it has 3 arguments-->
<script>
  const heading = React.createElement("h1",{},"Hello World KHUSHU!!!"); 
  //core react thing, just creating a h1 element inside react



  const root = ReactDOM.createRoot(document.getElementById("root"));
  //created a root inside header react for our react library, everything we render we will render inside this root, here in this root all the react code will run 
  // root = <div id = "root"></div>



  root.render(heading);


  // React.createElement,ReactDOM.createRoot,root.render(heading)=all this actually putting heading inside root(heading inside div)
</script>





